{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:idp:telos:host:1.2.0",
  "title": "idp.telos.host 1.2.0",
  "description": "idp-host（Agent Hosting & Coordination）对外发布的契约：AgentRelease（agent 行为的不可变发布件，ADR-0001 D2；1.1.0 起可嵌入 Skill，D17）、SkillRelease（skill 的不可变发布件）、Envelope（发布件加内容摘要）、AgentRun（一次运行的记录，API 返回的形态）和 RunOptions（1.2.0 起：创建运行时的调用方选项，D19）。生产者是 idp-host，权威副本在 idp-host/api/contracts/，由 go test ./internal/run -run TestContract 保证与实现一致；idp-contracts 中的副本只能与之逐字节相同。JSON Schema 只描述形状与可本地判定的规则；摘要是否匹配由 agent.Open / agent.OpenSkill 判定，运行时不变量由 HOST 的状态机判定。",
  "oneOf": [
    {"$ref": "#/$defs/AgentRelease"},
    {"$ref": "#/$defs/SkillRelease"},
    {"$ref": "#/$defs/Envelope"},
    {"$ref": "#/$defs/AgentRun"},
    {"$ref": "#/$defs/RunOptions"}
  ],
  "$defs": {
    "AgentRelease": {
      "title": "AgentRelease",
      "description": "一个 agent 的一次发布：编号、创建与审批信息，固定下来的定义（指令、模型、工具、确认策略、限制、skill 引用），以及编译时解析并嵌入的 skill 发布件（与引用一一对应、同序）。审批人参与摘要。schemaVersion 固定为 idp.host.agent/v1。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "releaseId", "tenantId", "agentId", "agentName", "version", "createdAt", "createdBy", "definition"],
      "properties": {
        "schemaVersion": {"const": "idp.host.agent/v1"},
        "releaseId": {"type": "string", "minLength": 1},
        "tenantId": {"type": "string", "minLength": 1},
        "agentId": {"type": "string", "minLength": 1},
        "agentName": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"},
        "version": {"type": "integer", "minimum": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "createdBy": {"type": "string", "minLength": 1},
        "approvedBy": {"type": "string", "minLength": 1},
        "definition": {"$ref": "#/$defs/Definition"},
        "skills": {"type": "array", "items": {"$ref": "#/$defs/EmbeddedSkill"}}
      }
    },
    "Definition": {
      "title": "Definition",
      "description": "agent 行为的全部输入：系统指令、模型配置、工具策略、确认策略、限制，以及按名字（可钉版本）引用的 skill。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "model", "tools", "confirmation", "limits"],
      "properties": {
        "instructions": {"type": "string", "minLength": 1, "maxLength": 65536},
        "model": {"$ref": "#/$defs/ModelProfile"},
        "tools": {"$ref": "#/$defs/ToolPolicy"},
        "confirmation": {"$ref": "#/$defs/ConfirmationPolicy"},
        "limits": {"$ref": "#/$defs/Limits"},
        "skills": {"type": "array", "items": {"$ref": "#/$defs/SkillRef"}}
      }
    },
    "SkillRef": {
      "title": "SkillRef",
      "description": "agent 定义对 skill 的引用：名字，可选钉住的版本（缺省或 0 = 编译时该 skill 的当前发布）。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "SkillDefinition": {
      "title": "SkillDefinition",
      "description": "skill 的内容：指令片段、它需要的工具（网关暴露名）、它要求的确认覆盖（confirm 在合并时优先）。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions", "tools"],
      "properties": {
        "instructions": {"type": "string", "minLength": 1, "maxLength": 65536},
        "tools": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"}},
        "confirmation": {"type": "object", "additionalProperties": {"enum": ["auto", "confirm"]}}
      }
    },
    "EmbeddedSkill": {
      "title": "EmbeddedSkill",
      "description": "编译 AgentRelease 时嵌入的 skill 发布件：名字、版本、该 SkillRelease 的摘要与内容。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "digest", "definition"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"},
        "version": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "definition": {"$ref": "#/$defs/SkillDefinition"}
      }
    },
    "SkillRelease": {
      "title": "SkillRelease",
      "description": "一个 skill 的一次发布：编号、创建与审批信息，以及固定下来的内容。审批人参与摘要。schemaVersion 固定为 idp.host.skill/v1。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "releaseId", "tenantId", "skillId", "skillName", "version", "createdAt", "createdBy", "definition"],
      "properties": {
        "schemaVersion": {"const": "idp.host.skill/v1"},
        "releaseId": {"type": "string", "minLength": 1},
        "tenantId": {"type": "string", "minLength": 1},
        "skillId": {"type": "string", "minLength": 1},
        "skillName": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"},
        "version": {"type": "integer", "minimum": 1},
        "createdAt": {"type": "string", "format": "date-time"},
        "createdBy": {"type": "string", "minLength": 1},
        "approvedBy": {"type": "string", "minLength": 1},
        "definition": {"$ref": "#/$defs/SkillDefinition"}
      }
    },
    "ModelProfile": {
      "title": "ModelProfile",
      "description": "模型选择：provider 是 HOST 配置里登记的名字，fallbacks 按序在主 provider 失败时尝试。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$"},
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "maxOutputTokens": {"type": "integer", "minimum": 0},
        "fallbacks": {"type": "array", "items": {"$ref": "#/$defs/ModelRef"}}
      }
    },
    "ModelRef": {
      "title": "ModelRef",
      "description": "一个 provider 与模型 id。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$"},
        "model": {"type": "string", "minLength": 1}
      }
    },
    "ToolPolicy": {
      "title": "ToolPolicy",
      "description": "agent 可用的工具：gateway 是 HOST 配置里登记的 MCP 网关名，allow 是网关对调用者暴露的工具名（\"*\" = 全部）；空 allow 表示没有工具。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["allow"],
      "properties": {
        "gateway": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]{0,38}[a-z0-9])?$"},
        "allow": {"type": "array", "items": {"type": "string", "pattern": "^([A-Za-z0-9_.-]{1,128}|\\*)$"}}
      }
    },
    "ConfirmationPolicy": {
      "title": "ConfirmationPolicy",
      "description": "哪些工具调用要先经 Run 所有者确认（ADR-0001 D7）：default 对所有工具生效，tools 按工具覆盖。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {"enum": ["auto", "confirm"]},
        "tools": {"type": "object", "additionalProperties": {"enum": ["auto", "confirm"]}}
      }
    },
    "Limits": {
      "title": "Limits",
      "description": "一次 Run 的上限：步数、每步工具调用数、运行时限、确认等待时限（秒）、token 上限（缺省或 0 = 租户策略的默认值）。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSteps", "maxToolCallsPerStep", "runTimeoutSeconds", "confirmationTimeoutSeconds"],
      "properties": {
        "maxSteps": {"type": "integer", "minimum": 1, "maximum": 200},
        "maxToolCallsPerStep": {"type": "integer", "minimum": 1, "maximum": 64},
        "runTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "confirmationTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "maxTokensPerRun": {"type": "integer", "minimum": 1, "maximum": 100000000}
      }
    },
    "Envelope": {
      "title": "Envelope",
      "description": "存储与分发的形态：AgentRelease 或 SkillRelease 加其摘要（规范化 JSON 的 sha256:<hex>）。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "document"],
      "properties": {
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "document": {"oneOf": [{"$ref": "#/$defs/AgentRelease"}, {"$ref": "#/$defs/SkillRelease"}]}
      }
    },
    "AgentRun": {
      "title": "AgentRun",
      "description": "一次运行的记录（HOST 的权威状态，ADR-0001 D3）：线程、agent 与运行它的 release 摘要、所有者、状态机状态、步数、失败原因、调用方（EER）的 executionRef、追踪 id 与时间。其他系统用 runId 引用它，不复制它的状态。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "threadId", "agentId", "releaseId", "releaseDigest", "owner", "status", "stepCount", "cancelRequested", "deadlineAt", "createdAt"],
      "properties": {
        "runId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
        "threadId": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$"},
        "agentId": {"type": "string", "minLength": 1},
        "releaseId": {"type": "string", "minLength": 1},
        "releaseDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "owner": {"type": "string", "minLength": 1},
        "status": {"enum": ["QUEUED", "RUNNING", "AWAITING_INPUT", "COMPLETED", "FAILED", "CANCELED"]},
        "stepCount": {"type": "integer", "minimum": 0},
        "cancelRequested": {"type": "boolean"},
        "failureCode": {"type": "string", "minLength": 1},
        "failureMessage": {"type": "string", "minLength": 1},
        "executionRef": {"type": "string", "minLength": 1, "description": "调用方（EER）的 Execution 引用，由 RunOptions 的 idp.host/executionRef 设置（ADR-0001 D10、D19）"},
        "traceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "deadlineAt": {"type": "string", "format": "date-time"},
        "createdAt": {"type": "string", "format": "date-time"},
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "RunOptions": {
      "title": "RunOptions",
      "description": "创建运行时的调用方选项（ADR-0001 D19）：RunAgentInput.forwardedProps 中 idp.host/ 开头的键组成的对象，AG-UI（POST /ag-ui/agents/{ref}）与 REST（POST /v1/agents/{ref}/runs）两个入口都接受。本定义只描述 idp.host/ 键：forwardedProps 里其他命名空间的键属于调用方，HOST 原样保存、不解释，不在本契约内；idp.host/ 下的未知键与任何不合规的值都使请求被拒绝（422），调用方不会误以为某个选项生效了。四项都进入幂等摘要：同一 runId / Idempotency-Key 带不同选项被拒绝（409）。",
      "x-idp-telos-owner": "idp.telos.host",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "idp.host/toolExecution": {"enum": ["server", "caller"], "description": "server（缺省）：按 release 的工具策略经 MCP 网关执行工具。caller：工具由调用方执行——模型只看到请求里的前端工具（tools），看不到 release 的网关工具；HOST 不换取网关凭据、不接触网关；只调用一次模型；模型提出的调用作为前端工具调用交回（运行以 interrupt 结束，调用记为 FRONTEND），调用方在下一次运行中回传结果。模型若调用未声明的工具，运行以 STEP_LIMIT 失败。"},
        "idp.host/releaseDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "description": "运行该 agent 的这一份发布件（AgentRelease 的 Envelope.digest），它必须是已批准的或已被取代的发布件，否则请求被拒绝（409）。缺省运行当前发布件。运行记录的 AgentRun.releaseDigest 就是实际运行的发布件。"},
        "idp.host/executionRef": {"type": "string", "pattern": "^[\\x21-\\x7e]{1,256}$", "description": "调用方的执行引用（EER 的 execution id），记录为 AgentRun.executionRef，用于两边的审计关联。"},
        "idp.host/maxOutputTokens": {"type": "integer", "minimum": 1, "maximum": 1048576, "description": "本次运行的模型输出上限：只能压低 release 的 model.maxOutputTokens，不能放大。"}
      }
    }
  }
}
