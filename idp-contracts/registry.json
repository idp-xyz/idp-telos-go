{
  "description": "idp.telos.* 契约登记：按模块分命名空间、各自独立版本。契约由生产者拥有并生成；登记的前提是生产者仓库里有实现侧一致性测试；消费者只用这里发布的版本；兼容性由工具检查。对象状态：PUBLISHED。命名空间状态：PUBLISHED / DRAFT（尚未发布）。",
  "namespaces": {
    "idp.telos.mcp": {
      "id": "urn:idp:telos:mcp:1.0.0",
      "version": "1.0.0",
      "status": "PUBLISHED",
      "published": "2026-11-03",
      "schema": "idp.telos.mcp/1.0.0/schema.json",
      "examples": "idp.telos.mcp/1.0.0/examples.json",
      "producer": {
        "repository": "idp-mcp",
        "path": "api/contracts",
        "consistency_test": "go test ./internal/release -run TestContract",
        "regenerate_examples": "go test ./internal/release -run TestContract -update"
      },
      "note": "MCP 基础设施（idp-mcp）的 Release（idp.mcp.release/v1）、Envelope 与 InvocationRecord。权威副本在 idp-mcp/api/contracts/，这里的副本必须逐字节相同（tools/validate.py 核对）。"
    },
    "idp.telos.host": {
      "id": "urn:idp:telos:host:1.3.0",
      "version": "1.3.0",
      "status": "PUBLISHED",
